{
  "name": "glospoliceband.org",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "glospoliceband",
    "gloucestershire",
    "brass",
    "band"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write --list-different .",
    "deploy": "gh-pages -d out --nojekyll",
    "verify": "npm run prettier:check && npm run lint && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "next": "16.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "16.0.6",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^24.0.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-airbnb-extended": "^2.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.0"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
