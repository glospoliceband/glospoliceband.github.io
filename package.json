{
  "name": "glospoliceband.org",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "glospoliceband",
    "gloucestershire",
    "brass",
    "band"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
