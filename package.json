  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "gh-pages": "^6.3.0",
    "next": "15.3.5",
    "prettier": "^3.2.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "^9.30.1",
    "eslint-config-next": "15.3.5",
    "eslint-config-prettier": "^10.1.5",
    "postcss": "^8",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  }
